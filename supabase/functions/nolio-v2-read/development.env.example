# LOCAL development only; no PAT needed or read by the mock runtime.
NOLIO_V2_ENABLED=false
NOLIO_V2_ENV=development
NOLIO_V2_MODE=mock
# Replace with the UUID of your LOCAL Supabase test user, not a production account.
NOLIO_V2_OWNER_USER_ID=11111111-1111-4111-8111-111111111111
# Synthetic identity returned by the server-side mock.
NOLIO_V2_EXPECTED_NOLIO_USER_ID=usr_DemoOwner
NOLIO_V2_EXPECTED_APP_NAME=TFCLab development mock
NOLIO_V2_CONNECTION_KEY=tfc-development-mock
NOLIO_V2_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
